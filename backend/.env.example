# Configuração básica
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ditado
DB_USER=ditado
DB_PASSWORD=ditado_dev

# JWT e bcrypt
# Preencha JWT_SECRET no backend/.env com pelo menos 32 bytes aleatórios seguros.
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Groq
# Preencha GROQ_API_KEY somente no backend/.env.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Recuperação de senha e Brevo
# Quando habilitada, substitua EMAIL_FROM por um remetente válido configurado na Brevo.
PASSWORD_RESET_ENABLED=false
BREVO_API_KEY=
EMAIL_FROM=no-reply@localhost.test
EMAIL_FROM_NAME=Ditado

# Bootstrap administrativo
# ADMIN_PASSWORD é utilizado somente pelo procedimento de bootstrap.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@localhost.test
ADMIN_PASSWORD=

# Rate limiting
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=3600
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=900
RATE_LIMIT_RESET_PASSWORD_MAX=10
RATE_LIMIT_TRANSCRIPTION_WINDOW_SECONDS=3600
RATE_LIMIT_TRANSCRIPTION_MAX=20
